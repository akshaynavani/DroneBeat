# Copy to .env and adjust. No secrets are required; the service runs without auth.
DRONEBEAT_GRPC_ADDRESS=0.0.0.0:50051
DRONEBEAT_REST_HOST=0.0.0.0
# Inside the container REST always listens on 8080 (the compose healthcheck relies on it).
DRONEBEAT_REST_PORT=8080
DRONEBEAT_DB_PATH=/data/dronebeat.db
DRONEBEAT_STALE_AFTER_MS=5000
DRONEBEAT_LOST_AFTER_MS=30000
DRONEBEAT_LOW_BATTERY_PCT=20
DRONEBEAT_SWEEP_INTERVAL_MS=1000
DRONEBEAT_HISTORY_RETENTION_MS=86400000

# Host-side port mappings used by docker-compose
DRONEBEAT_GRPC_HOST_PORT=50051
DRONEBEAT_REST_HOST_PORT=8080

# Simulator (docker-compose `sim` service)
SIM_DRONES=20
SIM_DROPOUT_PROB=0.02
